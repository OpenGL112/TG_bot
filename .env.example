# Токен бота из @BotFather (обязательно)
BOT_TOKEN=
# Telegram user id администратора, которому приходят уведомления (обязательно)
ADMIN_ID=

# Таймзона салона
TIMEZONE=Europe/Minsk
# Рабочие часы и шаг слотов
WORK_START=09:00
WORK_END=18:00
SLOT_MINUTES=30
# Рабочие дни: 0=Пн ... 6=Вс
WORK_DAYS=0,1,2,3,4,5,6
# На сколько дней вперёд открыта запись
BOOKING_DAYS_AHEAD=30
# Информация о салоне — показывается в разделе «Помощь» (всё необязательно)
SALON_NAME=наш салон
SALON_ADDRESS=
SALON_PHONE=
SALON_URL=
LOG_LEVEL=INFO

# Путь к файлу базы (по умолчанию appointments.db рядом с ботом; в Docker — /app/data/appointments.db)
DATABASE_PATH=
